{
  "name": "instantsearch-itemsjs-adapter",
  "version": "2.0.0",
  "description": "An adapter to use ItemsJs based client-side search with an Algolia Instantsearch front-end.",
  "type": "module",
  "types": "./lib/adapter.d.ts",
  "exports": {
    ".": {
      "types": "./lib/adapter.d.ts",
      "default": "./lib/adapter.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "dependencies": {
    "@algolia/client-search": "^5.59.0",
    "itemsjs": "^2.4.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "2.4.1",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "test": "vitest run",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "build": "tsup",
    "format": "prettier --write \"{src,__tests__}/**/*.ts\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"{src,__tests__}/**/*.ts\" \"*.{js,ts}\"",
    "typecheck": "tsc",
    "lint:package": "publint && attw --pack . --profile esm-only"
  },
  "keywords": [
    "itemsjs",
    "instantsearch",
    "site-search",
    "client-side",
    "typescript"
  ],
  "author": "Performant Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/performant-software/instantsearch-itemsjs-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/performant-software/instantsearch-itemsjs-adapter/issues"
  },
  "homepage": "https://github.com/performant-software/instantsearch-itemsjs-adapter#readme",
  "volta": {
    "node": "24.21.0",
    "npm": "12.1.0"
  }
}
