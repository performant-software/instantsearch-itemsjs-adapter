{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,                  /* TypeScript 6 turns this on by default */
    "noEmit": true,                   /* tsdown emits the build and declarations */
    "isolatedModules": true,          /* tsdown compiles each file on its own */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src", "__tests__"]
}
